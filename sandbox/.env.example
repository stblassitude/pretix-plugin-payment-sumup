# Copy to .env and adjust.

# Public URL of the sandbox pretix. Keep the default for local testing without webhooks.
# When you use a tunnel (see the "tunnel" profile), set this to the https:// URL of the tunnel
# and restart with `docker compose up -d`.
PRETIX_URL=http://localhost:8345

# pretix image tag, e.g. "stable" or a specific release such as "2026.8.0".
PRETIX_VERSION=stable
